{
  "manifest_version": 3,
  "name": "Codex Usage Viewer",
  "description": "Shows your Codex usage from ChatGPT.",
  "version": "0.1.0",
  "icons": {
    "64": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Codex Usage",
    "default_icon": "icon.png"
  },
  "host_permissions": ["https://chatgpt.com/*"],
  "permissions": ["storage"]
}
